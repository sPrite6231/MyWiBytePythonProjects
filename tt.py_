import turtle
t = turtle.Turtle()
t.shape('turtle')

t.penup()
t.fillcolor('gold')
t.pencolor('black')
t.pensize(3)
t.goto(0, -25)
t.pendown()
t.begin_fill()
t.circle(100)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(0, 190)
t.pendown()
t.begin_fill()
t.goto(0, 230)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(130, 70)
t.pendown()
t.begin_fill()
t.goto(170, 70)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(0, -50)
t.pendown()
t.begin_fill()
t.goto(0, -90)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(-130, 70)
t.pendown()
t.begin_fill()
t.goto(-170, 70)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(85, 150)
t.pendown()
t.begin_fill()
t.goto(125, 185)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(-85, 150)
t.pendown()
t.begin_fill()
t.goto(-125, 185)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(85, 0)
t.pendown()
t.begin_fill()
t.goto(125, -35)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('orange')
t.fillcolor('orange')
t.goto(-85, 0)
t.pendown()
t.begin_fill()
t.goto(-125, -35)
t.end_fill()

t.penup()
t.pensize(2)
t.pencolor('DarkGreen')
t.fillcolor('LightGreen')
t.goto(-400, -190)
t.pendown()
t.begin_fill()
t.goto(400, -190)
t.goto(400, -290)
t.goto(-400, -290)
t.goto(-400, -190)
t.end_fill()



turtle.mainloop()
